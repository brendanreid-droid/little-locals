rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read access to events, write only for authenticated admins, except public clicks increment
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks is int
      );
    }
    
    // Public read access to blog posts, write only for authenticated admins, except public clicks increment
    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks is int
      );
    }
    
    // Allow public creation of newsletter subscriptions, admin-only read/write
    match /subscribers/{subscriberId} {
      allow create, delete: if true;
      allow read, update: if request.auth != null;
    }

    // Allow admin-only read/write access to newsletter history
    match /newsletter_history/{historyId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow public creation of scraper suggestions
    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Allow admin-only read/write access to dismissed suggestions
    match /dismissed_suggestions/{dismissedId} {
      allow read, write: if request.auth != null;
    }

    // Allow admin-only read/write access to archived event templates
    match /archived_events/{archivedId} {
      allow read, write: if request.auth != null;
    }

    // Allow public tracking of daily visits (writes/updates), read only by authenticated admins
    match /analytics_visits/{visitId} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.visits is int;
    }

    // Allow public increments of clicks in monthly analytics, read only by authenticated admins
    match /analytics_monthly_clicks/{clickId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
  }
}

